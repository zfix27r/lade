"states": [
    {
      "who": "CalendarMode",
      "how": "when",
      "what": {
        "LIST": "CalendarListLayout",
        "DAY, DAY_3, WEEK": "CalendarWeekLayout",
        "MONTH": "CalendarMonthGrid",
        "YEAR": "CalendarYearGrid"
      }
    },
    {
      "who": "CalendarView",
      "how": "when",
      "what": {
        "при CalendarMode.LIST": {
          "TIMELINE": "CalendarListEntries с временная линия. Слева полоса с временем. Записи компактные",
          "GROUP_KIND": "Группировка. Записи группируются по типу"
        },
        "при остальных CalendarMode": "NONE"
      }
    },
    {
      "who": "CalendarListStripMode",
      "how": "when",
      "what": {
        "при CalendarMode.LIST": {
          "WEEK": "показать календарь недели",
          "MONTH": "показать календарь месяца"
        }
      }
    },
    {
      "who": "CalendarDateMode",
      "how": "when",
      "what": {
        "FORWARD": "сдвинуть CalendarState.currentDate + CalendarMode",
        "BACKWARD": "сдвинуть CalendarState.currentDate - CalendarMode"
      }
    }
  ],
